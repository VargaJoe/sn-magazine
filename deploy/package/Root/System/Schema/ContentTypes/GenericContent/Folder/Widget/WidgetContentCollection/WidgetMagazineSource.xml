<ContentType name="WidgetMagazineSource" parentType="WidgetContentCollection" handler="SnMagazine.Editorial.EditorialSourceHandler" xmlns="http://schemas.sensenet.com/SenseNet/ContentRepository/ContentTypeDefinition">
  <DisplayName>Magazine catalogue and destinations</DisplayName>
  <Description>Bounded site catalogue query and native destination references for the reader-magazine template.</Description>
  <Icon>WebContent</Icon>
  <AllowedChildTypes />
  <Fields>
    <Field name="EditorialRoot" type="Reference"><DisplayName>Optional editorial root</DisplayName><Description>Opt-in reader layer: a same-site Folder directly below the site's Workspace. Empty preserves the legacy reader.</Description><Configuration><AllowMultiple>false</AllowMultiple><AllowedTypes><Type>Folder</Type></AllowedTypes></Configuration></Field>
    <Field name="BrandingFolder" type="Reference"><DisplayName>Branding assets folder</DisplayName><Description>Optional same-site Folder containing responsive header PNGs and site icons. See the reader-magazine asset contract.</Description><Configuration><AllowMultiple>false</AllowMultiple><AllowedTypes><Type>Folder</Type></AllowedTypes></Configuration></Field>
    <Field name="PageTitlePattern" type="ShortText"><DisplayName>Default title pattern</DisplayName><Description>Optional {title} and {site} placeholders; explicit context and Layout titles take priority.</Description></Field>
    <Field name="ArchivePage" type="Reference"><DisplayName>ArchivePage</DisplayName><Configuration><AllowMultiple>false</AllowMultiple><AllowedTypes><Type>GenericContent</Type></AllowedTypes></Configuration></Field>
    <Field name="CollectionsPage" type="Reference"><DisplayName>CollectionsPage</DisplayName><Configuration><AllowMultiple>false</AllowMultiple><AllowedTypes><Type>GenericContent</Type></AllowedTypes></Configuration></Field>
    <Field name="SearchPage" type="Reference"><DisplayName>SearchPage</DisplayName><Configuration><AllowMultiple>false</AllowMultiple><AllowedTypes><Type>GenericContent</Type></AllowedTypes></Configuration></Field>
    <Field name="AboutPage" type="Reference"><DisplayName>AboutPage</DisplayName><Configuration><AllowMultiple>false</AllowMultiple><AllowedTypes><Type>GenericContent</Type></AllowedTypes></Configuration></Field>
    <Field name="NewsRoot" type="Reference"><DisplayName>NewsRoot</DisplayName><Configuration><AllowMultiple>false</AllowMultiple><AllowedTypes><Type>GenericContent</Type></AllowedTypes></Configuration></Field>
    <Field name="CategoryRoots" type="Reference"><DisplayName>CategoryRoots</DisplayName><Configuration><AllowMultiple>true</AllowMultiple><AllowedTypes><Type>GenericContent</Type></AllowedTypes></Configuration></Field>
    <Field name="DefaultBrowseView" type="Choice"><DisplayName>Default browse view</DisplayName><Description>Initial browse order; the reader can still choose another available view.</Description><Configuration><AllowMultiple>false</AllowMultiple><AllowExtraValue>false</AllowExtraValue><Options><Option value="publication" selected="true">Publication order</Option><Option value="collections">Collections</Option></Options><DefaultValue>publication</DefaultValue></Configuration></Field>
    <Field name="CollectionRoots" type="Reference"><DisplayName>Additional collection directories</DisplayName><Description>Optional same-site Folder-derived directories for public collection navigation. Native permissions and reader visibility checks still apply.</Description><Configuration><AllowMultiple>true</AllowMultiple><AllowedTypes><Type>Folder</Type></AllowedTypes></Configuration></Field>
    <Field name="RecommendationMode" type="Choice"><DisplayName>Recommendation signals</DisplayName><Description>Select collection membership and tags, tags only, or disable recommendations.</Description><Configuration><AllowMultiple>false</AllowMultiple><AllowExtraValue>false</AllowExtraValue><Options><Option value="collections-and-tags" selected="true">Shared collections and tags</Option><Option value="tags">Shared tags</Option><Option value="none">Disabled</Option></Options><DefaultValue>collections-and-tags</DefaultValue></Configuration></Field>
    <Field name="RecommendationCount" type="Integer"><DisplayName>Maximum recommendations</DisplayName><Description>Zero hides recommendations.</Description><Configuration><MinValue>0</MinValue><MaxValue>12</MaxValue><DefaultValue>4</DefaultValue></Configuration></Field>
    <Field name="RecommendationCollectionWeight" type="Integer"><DisplayName>Shared collection weight</DisplayName><Description>Score per shared collection; zero disables this signal.</Description><Configuration><MinValue>0</MinValue><MaxValue>10</MaxValue><DefaultValue>2</DefaultValue></Configuration></Field>
    <Field name="RecommendationTagWeight" type="Integer"><DisplayName>Shared tag weight</DisplayName><Description>Score per shared tag; zero disables this signal.</Description><Configuration><MinValue>0</MinValue><MaxValue>10</MaxValue><DefaultValue>1</DefaultValue></Configuration></Field>
    <Field name="NewsWindowDays" type="Integer"><DisplayName>News freshness window (days)</DisplayName><Configuration><MinValue>1</MinValue><DefaultValue>30</DefaultValue></Configuration></Field>
  </Fields>
</ContentType>
