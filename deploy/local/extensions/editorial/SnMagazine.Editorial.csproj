<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SnMagazine.Editorial</AssemblyName>
    <RootNamespace>SnMagazine.Editorial</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>$(MSBuildProjectDirectory)/../../runtime/editorial-extension/bin/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Exact versions of the existing pinned local repository image. -->
    <PackageReference Include="SenseNet.ContentRepository" Version="[7.8.2-alpha.6]" PrivateAssets="all" />
    <PackageReference Include="SenseNet.Storage" Version="[7.8.2-alpha.6]" PrivateAssets="all" />
    <PackageReference Include="SenseNet.Security" Version="[4.3.1]" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../package/Root/System/Schema/ContentTypes/GenericContent/EditorialItem.xml" LogicalName="EditorialSchema.EditorialItem.xml" />
    <EmbeddedResource Include="../../../package/Root/System/Schema/ContentTypes/GenericContent/EditorialCollection.xml" LogicalName="EditorialSchema.EditorialCollection.xml" />
    <EmbeddedResource Include="../../../package/Root/System/Schema/ContentTypes/GenericContent/EditorialMembership.xml" LogicalName="EditorialSchema.EditorialMembership.xml" />
    <EmbeddedResource Include="../../../package/Root/System/Schema/ContentTypes/GenericContent/Folder/EditorialAnnotation.xml" LogicalName="EditorialSchema.EditorialAnnotation.xml" />
    <EmbeddedResource Include="../../../package/Root/System/Schema/ContentTypes/GenericContent/Folder/Widget/WidgetContentCollection/WidgetMagazineSource.xml" LogicalName="EditorialSchema.WidgetMagazineSource.xml" />
  </ItemGroup>
</Project>
