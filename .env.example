# Example environment variables for sn-magazine
# Copy this file to .env and fill in your actual values

REACT_APP_API_URL=https://repository.example
REACT_APP_AUTH_URL=https://identity.example
REACT_APP_CLIENT_ID=your-client-id
REACT_APP_SITE_HOST=https://site.example
REACT_APP_DATA_PATH=/Root/Content/your-data-path
REACT_APP_LOGO_PATH=/(structure)/Site/logo.png
REACT_APP_SITEMAP_PATH=/(structure)/Site/sitemap.xml
REACT_APP_OGIMAGE=/(structure)/Site/ogimage.png
REACT_APP_LAYOUT_TYPE=Layout
REACT_APP_WIDGET_TYPE=Widget
REACT_APP_PAGECONTAINER_PATH=/Root/Content/(layout)
REACT_APP_FB_APPID=your-facebook-app-id
REACT_APP_DISQUS_SHORTNAME=your-disqus-shortname
REACT_APP_MAINTENANCE_TEMPLATE=maintenance
REACT_APP_MAINTENANCE_SITE_NAME=Your Site Name
REACT_APP_MAINTENANCE_TITLE=Maintenance
REACT_APP_MAINTENANCE_EMAIL=your-email@example.com
REACT_APP_MAINTENANCE_TEXT=<p>Site is under maintenance. Please check back later.</p>

# Only for the manually run sitemap uploader, in a private local env file.
# Set ONE of these credentials; never use a REACT_APP_ prefix for a writer secret.
# SENSENET_API_KEY=...
# SENSENET_ACCESS_TOKEN=...
